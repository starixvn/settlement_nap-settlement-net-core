<!DOCTYPE html>
<html lang="en">
<head>
   @{
        var path = @ViewBag.NetCoreRootUrl;
    }
    <base href="@path/" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/styles.css" />
</head>
<body>
    <header>
        @await Html.PartialAsync("~/Views/Menu.cshtml")
    </header>
    <section>
        <div class="content"><app-root api-url="@ViewBag.RootUrl" page-type="@ViewBag.PageType">Loading...</app-root></div>
    </section>
     <script type="text/javascript">
        var element = document.getElementById("Calculate-menu");
        var elementAutoCalc = document.getElementById("AutoCalculate-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
        if (elementAutoCalc !== null) {
            elementAutoCalc.className = "active-menu";
        }
    </script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
</body>
</html>