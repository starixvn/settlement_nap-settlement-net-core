<!DOCTYPE html>
<html lang="en">
<head>
     @{
        var path = @ViewBag.NetCoreRootUrl;
    }
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="@path/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@path/css/styles.css" />
</head>
<body>
    @if (ViewBag.PageType == "MainPage")
    {
        <header>
           @{ Html.RenderPartial("~/Views/Header.cshtml"); }
        </header>
    }
    <div class="content">
        <app-root page-type="@ViewBag.PageType" api-url="@path">Loading...</app-root>
    </div>
</body>
</html>