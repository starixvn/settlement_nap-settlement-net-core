<!DOCTYPE html><html lang="en"><head>
    </head><body>@{
        var path = @ViewBag.NetCoreRootUrl;
    }
    <base href="@path/">
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="calculate-page/styles.f1af61b7fb168f7c621c.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="calculate-page/styles.f1af61b7fb168f7c621c.css"></noscript>


    <header>
        @await Html.PartialAsync("~/Views/Menu.cshtml")
    </header>
    <section>
        <div class="content">
            <app-root id="app" page-type="@ViewBag.PageType">Loading...</app-root>
        </div>
    </section>
    <script type="text/javascript">
        var pageType = document.getElementById('app').getAttribute('page-type')
        if (pageType == "Calculation") {
            var element = document.getElementById("Calculate-menu");
            if (element !== null) {
                element.className = "active-menu";
            }
        } else {
            var elementAutoCalc = document.getElementById("AutoCalculate-menu");
            if (elementAutoCalc !== null) {
                elementAutoCalc.className = "active-menu";
            }
        }
    </script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
<script src="calculate-page/runtime.12e53bd77baface2cb75.js" defer></script><script src="calculate-page/polyfills.f26cf2e5e947d51bbd14.js" defer></script><script src="calculate-page/main.31b763c72ff13bc6e549.js" defer></script>

</body></html>