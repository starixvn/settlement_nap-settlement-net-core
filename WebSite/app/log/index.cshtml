<!DOCTYPE html>
<html lang="en">
<head>
    
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
    @if (string.IsNullOrEmpty(Context.Request.Query["isShowMenu"]) || Context.Request.Query["isShowMenu"] == "true")
    {
        <header>
           @await Html.PartialAsync("~/Views/Menu.cshtml")
        </header>
    }
    <div class="content"><app-root>Loading...</app-root></div>
    <script type="text/javascript">
        var element = document.getElementById("SettlementLog-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
    </script>
    @if (string.IsNullOrEmpty(Context.Request.Query["isShowMenu"]) || Context.Request.Query["isShowMenu"] == "true")
    {
        <script src="/js/notification.js" type="text/javascript"></script>
    }
</body>
</html>