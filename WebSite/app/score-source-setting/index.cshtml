<!DOCTYPE html>
<html lang="en">
<head>
    <base href="/" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/styles.css" />
</head>
<body>
    <header>
        @await Html.PartialAsync("~/Views/Menu.cshtml")
    </header>
    <section>
        <div class="content">
            <app-root page-type="@ViewBag.PageType">Loading...</app-root>
        </div>
    </section>
    <script type="text/javascript">
        var element = document.getElementById("Settings-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
    </script>
    <script src="js/notification.js" type="text/javascript"></script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
</body>
</html>
