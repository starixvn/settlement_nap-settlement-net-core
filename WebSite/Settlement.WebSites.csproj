<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="app\**" />
    <Content Remove="app\**" />
    <EmbeddedResource Remove="app\**" />
    <None Remove="app\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Styles\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="App_Data\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Views\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Fanex.Caching.AspNetCore" Version="2.2.5" />
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.8" />
    <PackageReference Include="Fanex.Data.ProxyClient" Version="1.0.3.6" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.MailDeliver.MailClient" Version="2.1.0" />
    <PackageReference Include="Fanex.NAP.Client" Version="2.0.3" />
    <PackageReference Include="Fanex.NAP.SignIn" Version="2.0.3.1" />
    <PackageReference Include="Fanex.RemotingRef" Version="1.5.5.1" />
    <PackageReference Include="Fanex.Settlement.Converter" Version="1.0.0.1" />
    <PackageReference Include="Fanex.Settlement.MessageBridge" Version="1.0.8" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="MessagePack" Version="3.1.3" />
    <PackageReference Include="MessagePack.AspNetCoreMvcFormatter" Version="3.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ONEbook.UM" Version="3.2.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sources\Settlement.EventManagement\Settlement.EventManagement.csproj" />
    <ProjectReference Include="..\Sources\Settlement.FastMarkets\Settlement.FastMarkets.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Gaming\Settlement.Gaming.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Log\Settlement.Log.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Outright\Settlement.Outright.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Setting\Settlement.Setting.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Sportsbook.MoveTickets\Settlement.Sportsbook.MoveTickets.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Sportsbook.Aio\Settlement.Sportsbook.Aio.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Sportsbook.OtherSports\Settlement.Sportsbook.OtherSports.csproj" />
    <ProjectReference Include="..\Sources\Settlement.Sportsbook.Soccer\Settlement.Sportsbook.Soccer.csproj" />
    <ProjectReference Include="..\Sources\Settlement.ThirdPartyProducts\Settlement.ThirdPartyProducts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.KLDR.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\css\styles.css">
