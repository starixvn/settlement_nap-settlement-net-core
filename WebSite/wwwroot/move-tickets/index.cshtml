<!DOCTYPE html><html lang="en"><head>
    <base href="/">
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="move-tickets/styles.5c2c3d7b7e55ce5f.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="move-tickets/styles.5c2c3d7b7e55ce5f.css"></noscript></head>
<body>
    <header>
        @await Html.PartialAsync("~/Views/Menu.cshtml")
    </header>
    <section>
        <div class="content">
            <app-root page-type="@ViewBag.PageType">Loading...</app-root>
        </div>
    </section>
    <script type="text/javascript">
        var element = document.getElementById("MoveTickets-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
    </script>
    <script src="js/notification.js" type="text/javascript"></script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
<script src="move-tickets/runtime.ec46827492bc92f3.js" type="module"></script><script src="move-tickets/polyfills.517001803e6b7c93.js" type="module"></script><script src="move-tickets/main.d7f33cb00b57fee1.js" type="module"></script>
</body></html>