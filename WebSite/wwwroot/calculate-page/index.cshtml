<!DOCTYPE html><html lang="en"><head>
    <base href="/calculate-page/">
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="styles.6fbcdb985d554003.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="styles.6fbcdb985d554003.css"></noscript></head>

<body>
    <header>
        @await Html.PartialAsync("~/Views/Menu.cshtml")
    </header>
    <section>
        <div class="content">
            <app-root id="app" page-type="@ViewBag.PageType">Loading...</app-root>
        </div>
    </section>
    <script type="text/javascript">
        var pageType = document.getElementById('app').getAttribute('page-type')
        if (pageType == "Calculation") {
            var element = document.getElementById("Calculate-menu");
            if (element !== null) {
                element.className = "active-menu";
            }
        } else {
            var elementAutoCalc = document.getElementById("AutoCalculate-menu");
            if (elementAutoCalc !== null) {
                elementAutoCalc.className = "active-menu";
            }
        }
    </script>
    <script src="js/notification.js" type="text/javascript"></script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
<script src="runtime.be84ce8e3071db44.js" type="module"></script><script src="polyfills.3bd8a58d1c86e7b4.js" type="module"></script><script src="main.fc328d7f27c799ff.js" type="module"></script>

</body></html>