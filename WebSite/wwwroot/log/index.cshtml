<!DOCTYPE html><html lang="en"><head>
     </head><body>@{
        var path = @ViewBag.NetCoreRootUrl;
    }
    <base href="@path/">
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="@path/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="@path/css/styles.css">
<link rel="stylesheet" href="@path/log/styles.22876bb03cc3e12d0fc5.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="@path/log/styles.22876bb03cc3e12d0fc5.css"></noscript>

    @if (string.IsNullOrEmpty(Context.Request.Query["isShowMenu"]) || Context.Request.Query["isShowMenu"] == "true")
    {
        <header>
           @await Html.PartialAsync("~/Views/Menu.cshtml")
        </header>
    }
    <div class="content"><app-root>Loading...</app-root></div>
    <script type="text/javascript">
        var element = document.getElementById("SettlementLog-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
    </script>
    <script src="js/notification.js" type="text/javascript"></script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
<script src="@path/log/runtime.12e53bd77baface2cb75.js" defer></script><script src="@path/log/polyfills.66f7d172d5d6c55a8226.js" defer></script><script src="@path/log/main.58a42ac02e21fac9185c.js" defer></script>
</body></html>