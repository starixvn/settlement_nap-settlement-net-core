<!DOCTYPE html><html lang="en"><head><base href="/log/">
    
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="styles.646a4d6615e17563.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="styles.646a4d6615e17563.css"></noscript></head>
<body>
    @if (string.IsNullOrEmpty(Context.Request.Query["isShowMenu"]) || Context.Request.Query["isShowMenu"] == "true")
    {
        <header>
           @await Html.PartialAsync("~/Views/Menu.cshtml")
        </header>
    }
    <div class="content"><app-root>Loading...</app-root></div>
    <script type="text/javascript">
        var element = document.getElementById("SettlementLog-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
    </script>
    @if (string.IsNullOrEmpty(Context.Request.Query["isShowMenu"]) || Context.Request.Query["isShowMenu"] == "true")
    {
        <script src="/js/notification.js" type="text/javascript"></script>
        @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
    }
<script src="runtime.6df3eaf70f2a83ca.js" type="module"></script><script src="polyfills.edc9b14ab4b65abd.js" type="module"></script><script src="main.d8971b875dc26721.js" type="module"></script>
</body></html>