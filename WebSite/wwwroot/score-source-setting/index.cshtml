<!DOCTYPE html><html lang="en"><head>
    <base href="/">
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="score-source-setting/styles.7754feaf3bcb5e6e.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="score-source-setting/styles.7754feaf3bcb5e6e.css"></noscript></head>
<body>
    <header>
        @await Html.PartialAsync("~/Views/Menu.cshtml")
    </header>
    <section>
        <div class="content">
            <app-root page-type="@ViewBag.PageType">Loading...</app-root>
        </div>
    </section>
    <script type="text/javascript">
        var element = document.getElementById("Settings-menu");
        if (element !== null) {
            element.className = "active-menu";
        }
    </script>
    <script src="js/notification.js" type="text/javascript"></script>
    @await Html.PartialAsync("~/Views/Shared/_Matomo.cshtml")
<script src="score-source-setting/runtime.ebfb19fdb8563849.js" type="module"></script><script src="score-source-setting/polyfills.99e48922b179f731.js" type="module"></script><script src="score-source-setting/main.0e3a365ff03a5437.js" type="module"></script>

</body></html>